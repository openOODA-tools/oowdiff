# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oowdiff-bin
_pkgname=oowdiff
pkgver=0.1.0
pkgrel=1
pkgdesc="Word-by-word visual text comparison highlighting insertions and deletions inline."
arch=('x86_64')
url="https://github.com/openOODA-tools/oowdiff"
license=('Apache-2.0')
depends=('glibc')
provides=('oowdiff')
conflicts=('oowdiff')
source_x86_64=("${url}/releases/download/v${pkgver}/oowdiff-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oowdiff-linux-x86_64" "${pkgdir}/usr/bin/oowdiff"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oowdiff-uninstall"
}
